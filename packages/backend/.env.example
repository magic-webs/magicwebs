# Written by `convex dev`. Everything below is set in the Convex dashboard or
# with `npx convex env set NAME value`, not in this file.
CONVEX_DEPLOYMENT=
#
# Convex environment variables:
#   WORKER_SECRET               shared secret for crawler workers
#   JWT_PRIVATE_KEY, JWKS       Convex Auth signing keys (`bun run secrets` generates them)
#   MAGIC_AGENT_CONVEX_URL      Magic Agent's Convex deployment (https://<name>.convex.cloud), where accounts live
#   MAGIC_AGENT_URL             Magic Agent's app origin, e.g. https://agent.magicwebs.ai (serves the chat widget's embed.js)
#   SITE_URL                    the platform UI's URL, e.g. http://localhost:3000 (OAuth redirects back here)
#   AUTH_GOOGLE_ID              Google OAuth client; its redirect URI is
#   AUTH_GOOGLE_SECRET            <CONVEX_SITE_URL>/api/auth/callback/google
#   SITES_ROOT_DOMAIN           e.g. magicwebs.ai (pages live at <slug>.magicwebs.ai)
#   CLOUDFLARE_API_TOKEN        token with Workers KV edit + SSL and Certificates edit
#   CLOUDFLARE_ACCOUNT_ID
#   CLOUDFLARE_KV_NAMESPACE_ID  the SITES namespace bound in apps/edge/wrangler.jsonc
#   CLOUDFLARE_ZONE_ID          zone that owns SITES_ROOT_DOMAIN (Cloudflare for SaaS)
#   CLOUDFLARE_FALLBACK_ORIGIN  CNAME target for custom domains, e.g. sites.magicwebs.ai
