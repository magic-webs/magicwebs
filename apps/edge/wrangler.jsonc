{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "magicwebs-sites",
  "main": "src/index.tsx",
  "account_id": "917c7f5184677666a15239fbec9a149f",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // Convex HTTP actions URL; the worker asks it which version is live.
    "CONVEX_SITE_URL": "https://fearless-stork-537.convex.site"
  },
  "kv_namespaces": [
    // Create with `wrangler kv namespace create SITES` and paste the id here.
    // Convex writes to the same namespace (CLOUDFLARE_KV_NAMESPACE_ID).
    { "binding": "SITES", "id": "534b87c703624163a4db6caceb569cf6" }
  ],
  "routes": [
    // Platform subdomains: <slug>.magicwebs.ai
    { "pattern": "*.magicwebs.ai/*", "zone_name": "magicwebs.ai" }
    // Custom hostnames from Cloudflare for SaaS arrive through the fallback origin.
    // Add this back once Cloudflare for SaaS is enabled on the zone:
    // { "pattern": "*/*", "zone_name": "magicwebs.ai" }
  ]
}
