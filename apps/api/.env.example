# Convex deployment URL (same as NEXT_PUBLIC_CONVEX_URL in apps/web)
CONVEX_URL=https://your-deployment.convex.cloud
# Vercel AI Gateway key; the AI SDK reads it automatically
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-5.5
PORT=8787
# Comma-separated browser origins allowed to call /chat
WEB_ORIGINS=http://localhost:3000
# Bearer token required by the /mcp endpoint
MCP_API_KEY=
