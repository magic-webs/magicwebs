# Convex deployment URL (same as NEXT_PUBLIC_CONVEX_URL in apps/web)
CONVEX_URL=https://your-deployment.convex.cloud
# Vercel AI Gateway key for the platform's AI chat; the AI SDK reads it automatically.
# MCP clients never use it: they bring their own model.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-5.5
PORT=8787
# Comma-separated browser origins allowed to call /chat
WEB_ORIGINS=http://localhost:3000
# MCP clients authenticate with personal API keys created on the dashboard's
# MCP page; there is no shared key.
