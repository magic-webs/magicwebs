# Convex deployment URL (same as NEXT_PUBLIC_CONVEX_URL in apps/web)
CONVEX_URL=https://your-deployment.convex.cloud
# Vercel AI Gateway key for the platform's AI chat; the AI SDK reads it automatically.
# MCP clients never use it: they bring their own model.
AI_GATEWAY_API_KEY=
PORT=8787
# Comma-separated browser origins allowed to call /chat
WEB_ORIGINS=http://localhost:3000
# MCP clients authenticate with personal API keys created on the dashboard's
# MCP page; there is no shared key.
# Cloudflare R2 (S3 API), for images, videos and files attached in the AI chat.
# The same bucket as the crawler's. Leave R2_BUCKET empty to turn uploads off.
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://assets.magicwebs.ai
