CONVEX_URL=https://your-deployment.convex.cloud
# Must match WORKER_SECRET in the Convex environment
WORKER_SECRET=
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-5.5
WORKER_ID=crawler-1
# Jobs arrive over a subscription; this only rechecks for stalled jobs.
STALE_CHECK_MS=120000
# Cloudflare R2 (S3 API). Leave R2_BUCKET empty to keep original image URLs.
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://assets.magicwebs.ai
