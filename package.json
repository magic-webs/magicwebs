{
  "name": "magicwebs",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "bun --filter @magicwebs/web dev",
    "dev:backend": "bun --filter @magicwebs/backend dev",
    "dev:api": "bun --filter @magicwebs/api dev",
    "dev:crawler": "bun --filter @magicwebs/crawler start",
    "dev:edge": "bun --filter @magicwebs/edge dev",
    "secrets": "bun scripts/generate-secrets.ts",
    "export-kit": "bun scripts/build-export-kit.ts",
    "icons": "bun scripts/build-icons.ts",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
